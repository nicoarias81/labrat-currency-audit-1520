--- a/android-native/engine/src/main/java/team/sopa/boar/engine/routing/Calculators.kt
+++ b/android-native/engine/src/main/java/team/sopa/boar/engine/routing/Calculators.kt
@@ -14,16 +14,20 @@
     data class Calculation(val kind: String, val text: String)
 
     private const val NUM = """(\d{1,3}(?:[.\s]\d{3})+(?:,\d+)?|\d+(?:[.,]\d+)?)"""
+    /** The thousands form NUM already accepts with a dot or a space: 12.000 / 1 200. */
+    private val THOUSANDS = JsRegex.re("""^\d{1,3}(?:[.\s]\d{3})+$""")
 
     private val WS_ANY = JsRegex.re("""\s""")
     private val COMMA_3_END = JsRegex.re(""",\d{3}$""")
 
     /** "7,5" / "7.5" / "1,200" / "1,200.5" / "18" -> number (NaN when it isn't one, as Number()). */
     fun parseNumber(raw: String): Double {
         val s = WS_ANY.replace(raw, "")
+        // NUM matches "12.000" as twelve thousand; the branches below only know "," as a thousands
+        // separator, so the value fell through to ('.') -> JsNumber.parse("12.000") -> 12.0.
+        if (THOUSANDS.containsMatchIn(s)) return JsNumber.parse(s.replace(".", ""))
         if (',' in s && '.' in s) {
             return JsNumber.parse(if (s.lastIndexOf(',') > s.lastIndexOf('.')) s.replace(".", "").replaceFirst(",", ".") else s.replace(",", ""))
         }
         if (',' in s) return if (COMMA_3_END.containsMatchIn(s)) JsNumber.parse(s.replace(",", "")) else JsNumber.parse(s.replaceFirst(",", "."))
         if ('.' in s) return JsNumber.parse(s)
         return JsNumber.parse(s)
     }

